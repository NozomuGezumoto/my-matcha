{
  "expo": {
    "name": "My Macha",
    "slug": "my-macha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/matcha-icon.png",
    "scheme": "mymacha",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/matcha-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d5016"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mymacha.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "地図を表示するために必要です。",
        "NSPhotoLibraryUsageDescription": "写真を選択・共有するためにフォトライブラリへのアクセスが必要です。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/matcha-icon.png",
        "backgroundColor": "#2d5016"
      },
      "package": "com.mymacha.app",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/matcha-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "写真を選択・共有するためにフォトライブラリへのアクセスが必要です。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
